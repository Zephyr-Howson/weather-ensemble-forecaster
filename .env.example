# Optional: override default local SQLite database path
WEATHER_DB_PATH=data/weather.db

# Default location if not supplied in the CLI
DEFAULT_LAT=-37.8136
DEFAULT_LON=144.9631
DEFAULT_LOCATION_NAME=Melbourne
DEFAULT_TIMEZONE=Australia/Melbourne

# Use a shorter window initially if you only have 2 weeks of data
ROLLING_WINDOW_DAYS=14

# Optional forecast providers. Leave a key blank to skip that provider (each run
# logs a warning for it). wttr.in, BOM and Open-Meteo need no key.
WEATHERAPI_KEY=
VISUAL_CROSSING_KEY=

# Uses the 5 Day / 3 Hour Forecast endpoint (/data/2.5/forecast), which every
# free OpenWeatherMap plan includes - no One Call subscription or card needed.
OPENWEATHERMAP_KEY=
WEATHERBIT_KEY=
ACCUWEATHER_KEY=

# SILO (Australia-only, BOM-derived, free) is not a live forecast provider - it's
# an alternative actuals/ground-truth source, called directly via
# weather_ensemble.sources.silo.fetch_actual rather than through --collect. It
# only needs an email address, not a formal API key.
SILO_EMAIL=

# Optional: powers the nightly per-location weather narrative (--narrate-best,
# see narrative.py). Leave blank to skip narrative generation entirely - the
# report simply omits that section rather than erroring.
ANTHROPIC_API_KEY=
